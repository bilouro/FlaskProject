# Copy to .env and fill in real values.
# All settings are read with the APP_ prefix by pydantic-settings.

APP_ENV=dev

# Database
APP_DB_HOST=127.0.0.1
APP_DB_PORT=5432
APP_DB_NAME=app_db
APP_DB_USER=app_user
APP_DB_PASSWORD=changeme

# Optional: full DSN — overrides the APP_DB_* fields above.
# APP_DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname
